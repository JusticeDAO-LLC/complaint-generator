+	def _build_temporal_next_actions_for_task(
+		self,
+		*,
+		claim_type: Any,
+		claim_element_id: Any,
+		claim_element_label: Any,
+		temporal_rule_profile_id: Any,
+		temporal_rule_status: Any,
+		temporal_rule_follow_ups: Any,
+		temporal_rule_blocking_reasons: Any,

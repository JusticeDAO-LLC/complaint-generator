	def _bundle_significant_tokens(self, value: str) -> List[str]:
		stop_words = {
			'the', 'and', 'for', 'that', 'with', 'from', 'what', 'when', 'who', 'how', 'about', 'around',
			'this', 'these', 'those', 'showing', 'facts', 'fact', 'occurred', 'applies', 'claim', 'element',

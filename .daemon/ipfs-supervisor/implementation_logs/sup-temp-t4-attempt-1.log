+				'claim_element_id': element_id,
+				'claim_element_label': element_label,
+				'temporal_missingness_kind': 'temporal_gap',
+				'follow_up_focus': 'temporal_gap_closure',
+				'query_strategy': 'temporal_gap_targeted',

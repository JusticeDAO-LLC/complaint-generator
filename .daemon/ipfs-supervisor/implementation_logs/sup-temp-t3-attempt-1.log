+            or []
+        )
+        if str(formula).strip()
+    ]
+    theorem_exports["tdfol_formulas"] = tdfol_formulas
+    theorem_exports["dcec_formulas"] = dcec_formulas
+    theorem_exports.setdefault("tdfol_preview", tdfol_formulas[:3])

        deterministic_requirement_tokens_updated: Set[str] = set()
        deterministic_relationship_tokens_updated: Set[str] = set()
        deterministic_entity_tokens_updated: Set[str] = set()
        deterministic_plan_fields_captured: Set[str] = set()

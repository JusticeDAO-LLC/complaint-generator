+
+    def _select_proof_directed_candidates(
+        self,
+        candidates: List[Dict[str, Any]],
+        *,
+        max_questions: int,
+        preserve_order: bool = True,
+    ) -> List[Dict[str, Any]]:
+        if max_questions <= 0:

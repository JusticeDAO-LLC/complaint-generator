        "workflow_phases": _unique_metadata_strings(
            list(metadata.get("workflow_phases") or []) + list(payload.get("workflow_phases") or [])
        ),
        "issue_family": _normalize_text(payload.get("issue_family") or metadata.get("issue_family") or ""),
    }



+	def _summarize_proof_lead_collection(self, proof_leads: Any) -> Dict[str, Any]:
+		normalized_leads = [lead for lead in proof_leads if isinstance(lead, dict)] if isinstance(proof_leads, list) else []
+		summary: Dict[str, Any] = {

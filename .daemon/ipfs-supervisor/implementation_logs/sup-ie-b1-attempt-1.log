+def _ensure_stable_intake_record_ids(
+    records: Any,
+    *,
+    id_key: str,
+    prefix: str,
+) -> List[Dict[str, Any]]:
+    normalized_records = [
+        dict(record)
+        for record in (records if isinstance(records, list) else [])

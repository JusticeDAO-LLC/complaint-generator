+            continue
+        while f"{prefix}_{next_index:03d}" in seen_ids:
+            next_index += 1
+        record[id_key] = f"{prefix}_{next_index:03d}"
+        seen_ids.add(record[id_key])
+        next_index += 1
+    return normalized_records

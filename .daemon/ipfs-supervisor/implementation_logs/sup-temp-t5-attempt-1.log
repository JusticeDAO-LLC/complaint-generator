 succeeded in 0ms:
                ? `<div class="muted"><strong>Question Review Targets</strong></div><div class="inline-link-row">${questionTargetLinks.join('')}</div>`
                : '';
            document.getElementById('traceIntakeConfirmation').innerHTML = renderIntakeSummaryConfirmation(
                intakeCaseSummary,
                traceDashboardUrl,
            );
            document.getElementById('traceTemporalHandoff').innerHTML = renderClaimSupportTemporalHandoff(
                claimSupportTemporalHandoff,
                traceDashboardUrl,
            );

            // T5: Derive chronology_blocker_summary from trace data if not present as an
            // explicit field.  The document builder stores it in draft.source_context but
            // optimization trace payloads carry the same underlying data through
            // claimSupportPacketSummary and claimReasoningReview.
            const traceChronologyBlocker = (trace.chronology_blocker_summary && typeof trace.chronology_blocker_summary === 'object')
                ? trace.chronology_blocker_summary
                : (() => {
                    const unresolvedCount = Number(claimSupportPacketSummary.claim_support_unresolved_temporal_issue_count || 0);
                    const gapTaskCount = Number(claimSupportPacketSummary.temporal_gap_task_count || 0);
                    const proofScore = Number(claimSupportPacketSummary.proof_readiness_score || 0);
                    // Tally failed rule profile elements across all claims in claimReasoningReview.
                    let failedElementCount = 0;
                    const failedFrameIds = [];
                    if (claimReasoningReview && typeof claimReasoningReview === 'object') {
                        for (const claimKey of Object.keys(claimReasoningReview)) {
                            const cr = claimReasoningReview[claimKey];
                            if (!cr || typeof cr !== 'object') { continue; }
                            failedElementCount += Number(cr.temporal_rule_profile_failed_element_count || 0);
                            if (cr.proof_bundles && typeof cr.proof_bundles === 'object') {
                                for (const bundle of Object.values(cr.proof_bundles)) {
                                    if (!bundle || typeof bundle !== 'object') { continue; }
                                    const st = String(bundle.status || '').trim();
                                    const rfId = String(bundle.rule_frame_id || '').trim();
                                    if ((st === 'failed' || st === 'partial') && rfId && !failedFrameIds.includes(rfId)) {
                                        failedFrameIds.push(rfId);
                                    }
                                }
                            }
                        }
                    }
                    const blocked = Boolean(unresolvedCount > 0 || gapTaskCount > 0 || failedElementCount > 0);
                    if (!blocked) { return null; }
                    const parts = [];
                    if (gapTaskCount > 0) { parts.push(`${gapTaskCount} pending chronology gap ${gapTaskCount === 1 ? 'task' : 'tasks'}`); }
                    if (unresolvedCount > 0) { parts.push(`${unresolvedCount} unresolved temporal ${unresolvedCount === 1 ? 'issue' : 'issues'}`); }
                    if (failedElementCount > 0) { parts.push(`${failedElementCount} ${failedElementCount === 1 ? 'element' : 'elements'} with failed temporal rule profile`); }
                    return {
                        chronology_blocked: blocked,
                        proof_readiness_score: proofScore,
                        temporal_gap_task_count: gapTaskCount,
                        unresolved_temporal_issue_count: unresolvedCount,
                        temporal_rule_profile_failed_element_count: failedElementCount,
                        failed_rule_frame_ids: failedFrameIds,
                        summary: parts.length ? `Chronology blockers remain: ${parts.join('; ')}.` : '',
                    };
                })();
            document.getElementById('traceChronologyBlockerSummary').innerHTML = renderChronologyBlockerSummary(
                traceChronologyBlocker,


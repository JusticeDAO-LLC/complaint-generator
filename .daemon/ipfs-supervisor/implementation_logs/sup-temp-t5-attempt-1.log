        function renderChronologyBlockerSummary(chronologyBlockerSummary, dashboardUrl) {
            if (!chronologyBlockerSummary || typeof chronologyBlockerSummary !== 'object') {
                return '';
            }
            const blocked = Boolean(chronologyBlockerSummary.chronology_blocked);
            const summary = String(chronologyBlockerSummary.summary || '').trim();
            const failedCount = Number(chronologyBlockerSummary.temporal_rule_profile_failed_element_count || 0);
            const unresolvedCount = Number(chronologyBlockerSummary.unresolved_temporal_issue_count || 0);
            const gapTaskCount = Number(chronologyBlockerSummary.temporal_gap_task_count || 0);
            const proofScore = Number(chronologyBlockerSummary.proof_readiness_score || 0);
            const failedRuleFrameIds = Array.isArray(chronologyBlockerSummary.failed_rule_frame_ids)
                ? chronologyBlockerSummary.failed_rule_frame_ids.filter((id) => String(id || '').trim())
                : [];

            if (!blocked && !unresolvedCount && !gapTaskCount && !failedCount) {
                return '';
            }

            const statusLabel = blocked ? 'blocked' : 'pending';
            const chips = [
                failedCount > 0
                    ? `<span class="chip">Failed rule elements: ${escapeHtml(String(failedCount))}</span>` : '',
                unresolvedCount > 0
                    ? `<span class="chip">Unresolved issues: ${escapeHtml(String(unresolvedCount))}</span>` : '',
                gapTaskCount > 0
                    ? `<span class="chip">Chronology tasks: ${escapeHtml(String(gapTaskCount))}</span>` : '',
                `<span class="chip">Proof readiness: ${escapeHtml(proofScore.toFixed(2))}</span>`,
                failedRuleFrameIds.length
                    ? `<span class="chip">Failed frames: ${escapeHtml(failedRuleFrameIds.join(', '))}</span>` : '',
            ].filter(Boolean);

            const claimSupportUrl = String(dashboardUrl || '/claim-support-review').trim();
            return `
                <div class="intake-handoff-card" data-status="${escapeHtml(statusLabel)}">
                    <div><strong>Chronology Blocker Summary</strong></div>
                    <div class="chip-row" style="margin-top: 10px;">${chips.join('')}</div>
                    ${summary ? `<div style="margin-top: 8px; font-size: 13px;">${escapeHtml(summary)}</div>` : ''}
                    <div class="inline-link-row" style="margin-top: 10px;">
                        <a class="inline-link" href="${escapeHtml(claimSupportUrl)}">${blocked ? 'Review chronology blockers' : 'Open chronology review'}</a>
                    </div>
                </div>
            `;
        }

        function renderClaimSupportTemporalHandoff(handoff, dashboardUrl) {
            const normalized = normalizeClaimSupportTemporalHandoff(handoff);
            if (!Object.keys(normalized).length) {
                return '';

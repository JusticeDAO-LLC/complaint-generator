    def _extract_logic_proof_counts(
        self,
        reasoning_diagnostics: Optional[Dict[str, Any]],
    ) -> Dict[str, int]:
        reasoning = reasoning_diagnostics if isinstance(reasoning_diagnostics, dict) else {}
        logic_proof = reasoning.get('logic_proof', {})

+        for fact in facts
+        if _normalize_text(fact.get("fact_id") or fact.get("temporal_fact_id") or "")
+    ]
+    relation_ids = [
+        _normalize_text(relation.get("relation_id") or "")
+        for relation in relations
+        if _normalize_text(relation.get("relation_id") or "")

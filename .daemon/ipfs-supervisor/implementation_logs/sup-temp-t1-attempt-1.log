    )
"""


class ClaimSupportHook:
    """Track which evidence and authorities support each claim type."""

    _CONTENT_ORIGIN_ARTIFACT_FAMILY = {
        'historical_archive_capture': 'archived_web_page',
        'live_web_capture': 'live_web_page',

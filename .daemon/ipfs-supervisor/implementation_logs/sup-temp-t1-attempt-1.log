+
+        selected_facts = [
+            facts_by_id[fact_id]
+            for fact_id in sorted(selected_fact_ids)
+            if fact_id in facts_by_id
+        ]
+        selected_issues: List[Dict[str, Any]] = []
+        for issue in issues:
+            issue_claim_keys = _temporal_record_claim_keys(issue)
+            issue_fact_ids = {

+            "trace_relation_ids": relation_ids,
+            "trace_issue_ids": issue_ids,
+            "blocking_issue_ids": blocking_issue_ids,
+            "missing_temporal_predicates": missing_temporal_predicates,
+            "required_provenance_kinds": required_provenance_kinds,

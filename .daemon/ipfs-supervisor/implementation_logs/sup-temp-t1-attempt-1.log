+    open_issue_ids: List[str] = []
+    blocking_issue_ids: List[str] = []
+    issue_type_counts: Dict[str, int] = {}
+    issue_status_counts: Dict[str, int] = {}
+    severity_counts: Dict[str, int] = {}

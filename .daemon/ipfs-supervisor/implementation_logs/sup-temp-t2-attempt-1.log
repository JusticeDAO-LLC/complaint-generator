            'environmental_law': 'environmental',
            'dei': 'employment'
        }
        
        category = category_map.get(complaint_type, 'general')
        
        # Get keywords for context
        keywords = get_type_specific_keywords('complaint', complaint_type)
        
        # Generate type-specific tree

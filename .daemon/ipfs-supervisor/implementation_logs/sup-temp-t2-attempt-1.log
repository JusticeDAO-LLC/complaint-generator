+
+_TEMPORAL_RULE_PROFILE_REGISTRY: Dict[str, TemporalRuleProfileContract] = {
+    _RETALIATION_TEMPORAL_PROFILE.profile_id: _RETALIATION_TEMPORAL_PROFILE,
+}
+
+_CLAIM_TYPE_PROFILE_ALIASES: Dict[str, str] = {

+            r"\b(because of|in response to|retaliated after)\b",
+        ],
+        'limitations_or_exhaustion': [
+            r"\b(EEOC charge|administrative charge|exhaustion)\b",
+            r"\b(180 days|300 days|filing deadline|limitations period)\b",
+        ],
+    },
